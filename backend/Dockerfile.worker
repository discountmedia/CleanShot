# syntax=docker/dockerfile:1.7
# ═══════════════════════════════════════════════════════════════════
#  CleanShot Worker container — Arq + pyvips + google-genai
#  Target: Cloud Run service (min-instances=1, CPU always-allocated)
#          OR local docker-compose
# ═══════════════════════════════════════════════════════════════════

FROM python:3.12-slim AS runtime

RUN groupadd --system --gid 1001 cleanshot \
 && useradd  --system --uid 1001 --gid cleanshot --home /app cleanshot

# libvips42 = runtime shared library that pyvips' cffi loads.
# We do NOT need libvips-dev at runtime (headers only needed to compile, and
# we use the pyvips wheel which links via cffi ABI mode).
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      libvips42 \
      ca-certificates \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY requirements-base.txt requirements-worker.txt ./
RUN pip install --no-cache-dir --upgrade pip \
 && pip install --no-cache-dir -r requirements-worker.txt \
 && rm -rf /root/.cache/pip

COPY app/ ./app/

USER cleanshot

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

# No exposed port — Arq is a pure Redis-polling worker.
# On Cloud Run, deploy with --no-cpu-throttling and --min-instances=1 so
# the worker process keeps running between invocations.
CMD ["arq", "app.workers.arq_worker.WorkerSettings"]
