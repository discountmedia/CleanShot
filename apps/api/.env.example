# CleanShot API — apps/api/.env.example
# Copy to .env for local development. NEVER commit .env.
# In Cloud Run: all values arrive via --set-secrets from Secret Manager.

# ── GCP ──────────────────────────────────────────────────────────────────────
GCP_PROJECT=cleanshot-493512
GCP_REGION=us-central1

# ── Database (Cloud SQL Postgres 17) ─────────────────────────────────────────
# Local: use Cloud SQL Auth Proxy or direct TCP
DATABASE_URL=postgresql://cleanshot:password@localhost:5432/cleanshot

# ── GCS Buckets ───────────────────────────────────────────────────────────────
GCS_BUCKET_ORIGINALS=cleanshot-originals-493512
GCS_BUCKET_DERIVATIVES=cleanshot-derivatives-493512

# ── Valkey / Memorystore ──────────────────────────────────────────────────────
VALKEY_URL=valkey://localhost:6379

# ── Cloud Tasks ───────────────────────────────────────────────────────────────
TASKS_QUEUE_GEN=cleanshot-image-gen
TASKS_QUEUE_SCAN=cleanshot-image-scan
TASKS_LOCATION=us-central1
# OIDC service account Cloud Tasks uses to sign task requests
TASKS_OIDC_SA=cleanshot-tasks@cleanshot-493512.iam.gserviceaccount.com
# The Cloud Run URL this service is deployed to (Cloud Tasks target audience)
WORKER_URL=https://cleanshot-api-<hash>-uc.a.run.app

# ── API Key (BFF → FastAPI internal channel) ─────────────────────────────────
# Stored in Secret Manager. Injected via Cloud Run --set-secrets.
API_KEY=change-me-in-secret-manager
API_KEY_PREV=

# ── AI Providers ─────────────────────────────────────────────────────────────
# Gemini: no key needed — uses Vertex AI IAM (ADC). Set to true to use.
SCAN_PROVIDER_OPENAI=false
SCAN_PROVIDER_ANTHROPIC=false

# Only set these if the corresponding provider is enabled:
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ── Operational ───────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
ENVIRONMENT=local
