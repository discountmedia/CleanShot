# ── Auth (Better Auth v1.6.11 + Microsoft OAuth) ─────────────────────────────
#
# AUTH_ENABLED:
#   "false" → bypass all auth, app works as today (dev/testing mode)
#   "true"  → Microsoft OAuth + domain/email gate enforced
AUTH_ENABLED=false

# Better Auth secret — generate with: openssl rand -hex 32
# Store in Secret Manager in production.
BETTER_AUTH_SECRET=change-me-generate-with-openssl-rand-hex-32

# Microsoft Azure App Registration credentials
# Register at: https://portal.azure.com → Microsoft Entra ID → App registrations
# Redirect URI: https://your-domain.com/api/auth/callback/microsoft
# For local dev: http://localhost:3000/api/auth/callback/microsoft
MICROSOFT_CLIENT_ID=your-azure-app-client-id
MICROSOFT_CLIENT_SECRET=your-azure-app-client-secret
MICROSOFT_TENANT_ID=common   # "common" = any MS account; set to your tenant ID to restrict

# ── Domain/email allowlist (env-var layer) ────────────────────────────────────
# Comma-separated. No spaces around commas.
# Domains: any @acme.com address passes
# Emails:  specific whitelisted addresses (e.g. personal Outlook)
ALLOWED_DOMAINS=acme.com,partner.org
ALLOWED_EMAILS=freelancer@outlook.com,contractor@gmail.com

# ── GCS lifecycle (set this on the derivatives bucket, not in code) ───────────
# Run once after bucket creation:
# gcloud storage buckets update gs://cleanshot-derivatives-prod \
#   --lifecycle-file=infra/gcs-lifecycle-approved.json
# See infra/gcs-lifecycle-approved.json for the 60-day rule on approved/ prefix.
